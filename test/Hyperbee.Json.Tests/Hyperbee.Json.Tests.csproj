<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Pinned, not inherited: Directory.Build.props adds netstandard2.1 for the
      shipped library, and there is no test host for netstandard2.1.
    -->
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Hyperbee.Json.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="TestSupport\Json\BookStore.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hyperbee.Json\Hyperbee.Json.csproj" />
  </ItemGroup>

  <!--
    Opt-in: run this suite against the netstandard2.1 build of the library instead of
    the matching net10.0/net11.0 build. netstandard2.1 is not a runtime and cannot host
    a test, so the tests still execute on net10.0 or net11.0; only the library under
    test changes. This is what exercises the #if NETSTANDARD branches and the shims in
    src/Shared.

      dotnet test <project> -f net10.0 -p:UseNetstandardAsset=true

    SetTargetFramework applies to this edge only, so a transitive project reference
    would need its own pin; this repo ships one library, so there is none.
  -->
  <ItemGroup Condition="'$(UseNetstandardAsset)' == 'true'">
    <ProjectReference Update="..\..\src\Hyperbee.Json\Hyperbee.Json.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>
</Project>